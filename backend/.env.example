# Solzen Backend Server Environment Configuration

# Server Port
PORT=5000

# Gmail SMTP Configuration
# Use your full Gmail address (e.g. yourbusiness@gmail.com)
GMAIL_USER=yourbusiness@gmail.com

# 16-character Google App Password (generated from Google Account > Security > 2-Step Verification > App passwords)
# Format: 16 letters without spaces (e.g. abcd efgh ijkl mnop)
GMAIL_APP_PASSWORD=your_16_digit_app_password

# Where should the contact inquiry emails be delivered?
CONTACT_RECEIVER=contact@solzen.in

# Allowed Frontend Origins for CORS (comma-separated or single URL)
# Example: http://localhost:5173,https://solzen-omega.vercel.app,https://solzen.in
FRONTEND_URL=http://localhost:5173

# Admin panel (website shortcut: Ctrl + Alt + A)
# Choose your own values. Never commit real credentials.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Long random string used to sign admin sessions (keeps admins logged in across restarts)
ADMIN_TOKEN_SECRET=replace-with-a-long-random-string
# Optional: where edited content is stored (must be on a persistent disk in production)
# CONTENT_FILE=/var/data/content.json
